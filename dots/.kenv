find-mk(){
  echo search in . for files ending in .mk containing $*
  find -type f -name '*.mk' | 
    while read mk_file; do \
       echo $mk_file>/dev/null; \
       if grep $* $mk_file; then \
          echo $mk_file; \
       fi; \
     done
  }


xdotnew(){
